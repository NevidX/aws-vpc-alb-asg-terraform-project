# Local .terraform directory containing downloaded providers and modules
.terraform/

# Terraform state files (contain current infrastructure configuration and potential sensitive data)
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Variable definition files (may contain sensitive passwords, tokens, or environment-specific values)
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json 